# LiveKit (MUST match the backend's credentials). The worker reads these three
# at startup and refuses to start naming whichever one is missing. Changing the
# project is an edit here and a restart.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM
CEREBRAS_API_KEY=

# STT
DEEPGRAM_API_KEY=

# TTS
INWORLD_API_KEY=

# Agent identity. MUST match the agent_name the frontend requests in room_config.
AGENT_NAME=assistant

# Optional error tracking
# SENTRY_DSN=

# Where this worker reports its calls, and the token it reports with.
# BACKEND_API_TOKEN must equal the backend's AGENT_SERVICE_TOKEN. Reporting is
# the only thing the worker asks the backend for: the LiveKit project above is
# read from this file, never fetched.
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TOKEN=

# Record calls in the console: post each call's start, its turns and its end to
# the backend. Needs the two values above. Console mode never reports.
BACKEND_REPORTING_ENABLED=false
