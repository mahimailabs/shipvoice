# LiveKit (MUST match the backend's credentials)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM
OPENAI_API_KEY=

# STT
DEEPGRAM_API_KEY=

# TTS
CARTESIA_API_KEY=

# Agent identity. MUST match the agent_name the frontend requests in room_config.
AGENT_NAME=assistant

