# Backend token endpoint (the FastAPI /token). Standard LiveKit token schema.
VITE_TOKEN_ENDPOINT=http://localhost:8000/api/v1/token

# Must match the agent worker's agent_name (AGENT_NAME in the agent package).
VITE_AGENT_NAME=assistant

# Backend base URL for the console (calls, agents, sign in). Baked at build
# time like the two above, so changing it needs a rebuild, not a restart.
VITE_API_BASE_URL=http://localhost:8000
